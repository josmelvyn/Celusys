// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  EMPLEADO
}

enum ProductType {
  CELULAR
  ACCESORIO
  REPUESTO
  OTRO
}

enum InventoryMovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum SaleStatus {
  COMPLETADA
  ANULADA
}

enum RepairStatus {
  RECIBIDO
  DIAGNOSTICO
  ESPERANDO_REPUESTO
  EN_REPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

// ==========================================
// USUARIOS Y ROLES
// ==========================================

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(EMPLEADO)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  sales              Sale[]
  inventoryMovements InventoryMovement[]
  assignedRepairs    Repair[]              @relation("TechnicianRepairs")
  statusHistories    RepairStatusHistory[]

  @@map("users")
}

// ==========================================
// CLIENTES
// ==========================================

model Customer {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  phone     String
  email     String?  @unique
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  sales   Sale[]
  repairs Repair[]

  @@map("customers")
}

// ==========================================
// CATEGORÍAS Y PRODUCTOS
// ==========================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relaciones
  products Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(uuid())
  sku         String      @unique
  name        String
  description String?
  brand       String
  type        ProductType @default(OTRO)
  
  // Campos específicos para Celulares
  model       String?
  imei        String?     @unique

  costPrice   Decimal     @db.Decimal(12, 2)
  salePrice   Decimal     @db.Decimal(12, 2)
  stock       Int         @default(0)
  minStock    Int         @default(2)
  
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relaciones
  saleItems          SaleItem[]
  inventoryMovements InventoryMovement[]
  repairParts        RepairPart[]

  @@map("products")
}

// ==========================================
// INVENTARIO Y MOVIMIENTOS
// ==========================================

model InventoryMovement {
  id        String                @id @default(uuid())
  productId String
  product   Product               @relation(fields: [productId], references: [id])
  quantity  Int
  type      InventoryMovementType
  reason    String
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  createdAt DateTime              @default(now())

  @@map("inventory_movements")
}

// ==========================================
// VENTAS Y DETALLES
// ==========================================

model Sale {
  id            String        @id @default(uuid())
  saleNumber    Int           @default(autoincrement())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0.00) @db.Decimal(12, 2)
  tax           Decimal       @default(0.00) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETADA)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relaciones
  items SaleItem[]

  @@map("sales")
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal  @default(0.00) @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)

  @@map("sale_items")
}

// ==========================================
// REPARACIONES Y TALLER
// ==========================================

model Repair {
  id             String       @id @default(uuid())
  orderNumber    Int          @default(autoincrement())
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  deviceBrand    String
  deviceModel    String
  imei           String?
  reportedProblem String
  diagnosis      String?
  workDone       String?
  estimatedCost  Decimal      @db.Decimal(12, 2)
  finalCost      Decimal?     @db.Decimal(12, 2)
  status         RepairStatus @default(RECIBIDO)
  
  technicianId   String?
  technician     User?        @relation("TechnicianRepairs", fields: [technicianId], references: [id])

  receivedAt     DateTime     @default(now())
  estimatedAt    DateTime?
  deliveredAt    DateTime?
  notes          String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relaciones
  statusHistory RepairStatusHistory[]
  usedParts     RepairPart[]

  @@map("repairs")
}

model RepairStatusHistory {
  id          String       @id @default(uuid())
  repairId    String
  repair      Repair       @relation(fields: [repairId], references: [id], onDelete: Cascade)
  previousStatus RepairStatus?
  newStatus   RepairStatus
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  notes       String?
  createdAt   DateTime     @default(now())

  @@map("repair_status_histories")
}

model RepairPart {
  id          String   @id @default(uuid())
  repairId    String
  repair      Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  isConfirmed Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("repair_parts")
}